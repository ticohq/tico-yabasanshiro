<resources>
    <string name="smb_card_title">从共享文件夹导入 (SMB)</string>
    <string name="smb_card_desc">从家庭网络中的电脑或 NAS 导入你用自己的光盘制作的游戏镜像</string>
    <string name="smb_dialog_title">共享文件夹 (SMB)</string>
    <string name="smb_pc_hint">在 Windows 中共享一个文件夹（属性 &gt; 共享）。主机请填写这台电脑在家庭网络中的 IP 地址：在命令提示符中运行 ipconfig，使用其中的“IPv4 地址”（例如 192.168.x.x）。请使用有权访问该文件夹的 Windows 本地账户登录；Microsoft 账户通常无法登录共享文件夹。</string>
    <string name="smb_host">主机名或 IP 地址</string>
    <string name="smb_share">共享名称</string>
    <string name="smb_username">用户名（可选）</string>
    <string name="smb_password">密码</string>
    <string name="smb_domain">域（可选）</string>
    <string name="smb_remember">记住此连接</string>
    <string name="smb_connect">连接</string>
    <string name="smb_import">导入</string>
    <string name="smb_import_count">导入 (%1$d)</string>
    <string name="smb_cancel_import">取消导入</string>
    <string name="smb_up_folder">..（上一级文件夹）</string>
    <string name="smb_empty">此处没有文件夹或游戏文件</string>
