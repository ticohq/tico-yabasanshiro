    <string name="smb_extracting">正在解压 %1$s</string>
    <string name="smb_error_host_required">请输入主机和共享名称</string>
    <string name="smb_error_auth">登录失败。请检查用户名、密码和域。</string>
    <string name="smb_error_share_not_found">未找到共享。请检查共享名称。</string>
    <string name="smb_error_unreachable">无法连接主机。请检查地址以及是否已开启文件共享。</string>
    <string name="smb_error_timeout">主机未及时响应。</string>
    <string name="smb_error_access_denied">访问被拒绝。</string>
