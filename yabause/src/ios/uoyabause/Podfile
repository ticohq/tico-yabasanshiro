# Uncomment the next line to define a global platform for your project
platform :ios, '15.0'

# Firestore security patch for the compromised eMudhra intermediate CAs.
# 12.19.3 is the lowest patched release on the 12.x line; do not go below it.
# See https://firebase.google.com/support/guides/compromised-emudhra-intermediate-ca
# The umbrella Firebase pod and its subspecs carry the 12.19.3 patch.
FIREBASE_VERSION = ['~> 12.19', '>= 12.19.3']
# 12.19.3 was a Firestore-only patch release: standalone pods such as
# FirebaseCrashlytics stayed at 12.19.0, so they only get the minor pin.
FIREBASE_COMPONENT_VERSION = ['~> 12.19']

# Pods shared by the full and the Lite app.
def shared_pods
  pod 'Firebase/Core', *FIREBASE_VERSION
  pod 'Firebase/Auth', *FIREBASE_VERSION
  pod 'Firebase/Database', *FIREBASE_VERSION
  pod 'Firebase/Storage', *FIREBASE_VERSION
  pod 'Firebase/Firestore', *FIREBASE_VERSION
  pod 'Firebase/Messaging', *FIREBASE_VERSION
  pod 'Firebase/InAppMessaging', *FIREBASE_VERSION
  pod 'Firebase/RemoteConfig', *FIREBASE_VERSION
  pod 'GoogleSignIn'
  pod 'FirebaseCrashlytics', *FIREBASE_COMPONENT_VERSION
  pod 'Kingfisher', '~> 7.0'
end

target 'YabaSnashiro' do
  # Comment the next line if you're not using Swift and don't want to use dynamic frameworks
  use_frameworks!
  shared_pods

  # Test bundles are hosted by YabaSnashiro and must not relink its pods, so
  # search-path inheritance is the right mode for them.
  target 'YabaSnashiroTests' do
    inherit! :search_paths
  end

  target 'YabaSnashiroUITests' do
    inherit! :search_paths
  end
end

# YabaSnashiro-Lite is a standalone app, not a bundle hosted by YabaSnashiro, so
# it needs a top-level target that links its own pods. As a nested
# `inherit! :search_paths` target CocoaPods skipped the statically vendored pods
# (FirebaseAnalytics, GoogleAppMeasurement*, GoogleAdsOnDeviceConversion),
# assuming a host app had already linked them, which left the APM symbols
# undefined at link time.
target 'YabaSnashiro-Lite' do
  use_frameworks!
  shared_pods
  pod 'Google-Mobile-Ads-SDK'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    # Xcode 26 clang turns -Wmissing-template-arg-list-after-template-kw into a
    # default error, which gRPC-Core 1.62.x source does not satisfy.
    if ['gRPC-Core', 'gRPC-C++'].include?(target.name)
      target.build_configurations.each do |config|
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] =
          "$(inherited) -Wno-error=missing-template-arg-list-after-template-kw"
      end
    end
    if target.name == 'BoringSSL-GRPC'
      target.source_build_phase.files.each do |file|
        if file.settings && file.settings['COMPILER_FLAGS']
          flags = file.settings['COMPILER_FLAGS'].split
          flags.reject! { |flag| flag == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }
          file.settings['COMPILER_FLAGS'] = flags.join(' ')
        end
      end
    end
  end
end
